[Unit]
Description=Personal Blog
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/personal-blog
User=personalblog
Group=personalblog
Environment=NODE_ENV=production
EnvironmentFile=/etc/personal-blog.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

---
// 全局悬浮音乐播放器：音源放在项目根目录的 music/ 文件夹（可用 BLOG_MUSIC_DIR 修改）。
// transition:persist 配合 ClientRouter，切换页面时音乐不中断。
---

<div class="music-player" data-music-player data-collapsed="false" hidden transition:persist>
  <audio data-mp-audio preload="metadata"></audio>
  <button class="mp-toggle" data-mp-toggle type="button" aria-label="展开或收起播放器" title="音乐播放器">♪</button>
  <div class="mp-body">
    <div class="mp-track">
      <span class="mp-label">NOW PLAYING</span>
      <span class="mp-title" data-mp-title>读取播放列表…</span>
    </div>
    <div class="mp-progress" data-mp-progress role="progressbar" aria-label="播放进度">
      <span class="mp-bar" data-mp-bar></span>
    </div>
    <div class="mp-controls">
      <button data-mp-prev type="button" aria-label="上一首">⏮</button>
      <button class="mp-play" data-mp-play type="button" aria-label="播放或暂停">▶</button>
      <button data-mp-next type="button" aria-label="下一首">⏭</button>
      <button data-mp-mode type="button" aria-label="播放顺序：顺序 / 随机 / 单曲循环" title="播放顺序">→</button>
      <input class="mp-volume" data-mp-volume type="range" min="0" max="100" value="80" aria-label="音量" title="音量" />
      <span class="mp-time" data-mp-time>--:--</span>
    </div>
  </div>
</div>

<style>
  .music-player {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: flex;
    align-items: stretch;
    border: 1px solid var(--ink);
    background: var(--panel);
    color: var(--panel-ink);
    box-shadow: 6px 6px 0 rgb(0 0 0 / 0.18);
    font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
  }
  .music-player[hidden] { display: none; }
  .mp-toggle {
    border: 0;
    border-right: 1px solid var(--panel-ink);
    padding: 0 12px;
    background: var(--accent);
    color: var(--panel);
    font-size: 1rem;
    cursor: pointer;
  }
  .mp-body { display: flex; flex-direction: column; gap: 8px; padding: 10px 14px; min-width: 230px; }
  .music-player[data-collapsed="true"] .mp-body { display: none; }
  .music-player[data-collapsed="true"] .mp-toggle { border-right: 0; padding: 10px 12px; }
  .mp-track { display: flex; flex-direction: column; gap: 2px; }
  .mp-label { color: var(--accent); font-size: .58rem; font-weight: 800; letter-spacing: .14em; }
  .mp-title {
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: .8rem;
    font-weight: 700;
  }
  .mp-progress {
    height: 5px;
    background: rgb(127 127 127 / 0.35);
    cursor: pointer;
  }
  .mp-bar { display: block; width: 0; height: 100%; background: var(--accent); }
  .mp-controls { display: flex; align-items: center; gap: 8px; }
  .mp-controls button {
    border: 1px solid currentColor;
    padding: 2px 8px;
    background: transparent;
    color: inherit;
    font-size: .78rem;
    cursor: pointer;
  }
  .mp-controls button:hover { background: var(--accent); border-color: var(--accent); color: var(--panel); }
  .mp-play { min-width: 36px; }
  .mp-volume { width: 64px; accent-color: var(--accent); cursor: pointer; }
  .mp-time { margin-left: auto; font-size: .68rem; opacity: .85; }
  @media (max-width: 640px) {
    .music-player { right: 10px; bottom: 10px; }
    .mp-body { min-width: 0; }
    .mp-title { max-width: 150px; }
  }
</style>

<script>
  interface Track { title: string; url: string }
  const STATE_KEY = 'music-player-state';

  const root = document.querySelector<HTMLElement>('[data-music-player]');
  if (root && !root.dataset.ready) {
    root.dataset.ready = '1';
    const audio = root.querySelector<HTMLAudioElement>('[data-mp-audio]')!;
    const title = root.querySelector<HTMLElement>('[data-mp-title]')!;
    const bar = root.querySelector<HTMLElement>('[data-mp-bar]')!;
    const progress = root.querySelector<HTMLElement>('[data-mp-progress]')!;
    const timeLabel = root.querySelector<HTMLElement>('[data-mp-time]')!;
    const playButton = root.querySelector<HTMLButtonElement>('[data-mp-play]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-mp-toggle]')!;
    let tracks: Track[] = [];
    let index = 0;
    type PlayMode = 'order' | 'random' | 'single';
    let mode: PlayMode = 'order';
    const modeButton = root.querySelector<HTMLButtonElement>('[data-mp-mode]')!;
    const volumeInput = root.querySelector<HTMLInputElement>('[data-mp-volume]')!;
    const MODE_META: Record<PlayMode, { icon: string; label: string }> = {
      order: { icon: '→', label: '顺序播放' },
      random: { icon: '⤨', label: '随机播放' },
      single: { icon: '↻', label: '单曲循环' },
    };

    const loadState = (): { index: number; time: number; playing: boolean; collapsed: boolean; mode: PlayMode; volume: number } => {
      try {
        return { index: 0, time: 0, playing: false, collapsed: false, mode: 'order', volume: 0.8, ...JSON.parse(localStorage.getItem(STATE_KEY) || '{}') };
      } catch {
        return { index: 0, time: 0, playing: false, collapsed: false, mode: 'order', volume: 0.8 };
      }
    };
    const saveState = (playing: boolean) => {
      try {
        localStorage.setItem(STATE_KEY, JSON.stringify({
          index, time: audio.currentTime, playing, collapsed: root.dataset.collapsed === 'true', mode, volume: audio.volume,
        }));
      } catch {}
    };
    const formatTime = (seconds: number) => {
      if (!Number.isFinite(seconds)) return '--:--';
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${String(s).padStart(2, '0')}`;
    };
    const applyMode = (next: PlayMode) => {
      mode = next;
      modeButton.textContent = MODE_META[mode].icon;
      modeButton.title = `播放顺序：${MODE_META[mode].label}`;
      saveState(!audio.paused);
    };
    const nextIndex = (step: 1 | -1): number => {
      if (mode === 'random' && tracks.length > 1) {
        let pick = index;
        while (pick === index) pick = Math.floor(Math.random() * tracks.length);
        return pick;
      }
      return ((index + step) % tracks.length + tracks.length) % tracks.length;
    };
    const select = (next: number, autoplay: boolean) => {
      if (!tracks.length) return;
      index = ((next % tracks.length) + tracks.length) % tracks.length;
      audio.src = tracks[index].url;
      title.textContent = tracks[index].title;
      title.title = tracks[index].title;
      bar.style.width = '0%';
      if (autoplay) audio.play().catch(() => {});
    };

    audio.addEventListener('play', () => { playButton.textContent = '⏸'; saveState(true); });
    audio.addEventListener('pause', () => { playButton.textContent = '▶'; saveState(false); });
    audio.addEventListener('ended', () => {
      if (mode === 'single') { audio.currentTime = 0; audio.play().catch(() => {}); }
      else select(nextIndex(1), true);
    });
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) bar.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
      timeLabel.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
    });
    audio.addEventListener('loadedmetadata', () => {
      timeLabel.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
    });

    playButton.addEventListener('click', () => {
      if (!tracks.length) return;
      if (audio.paused) audio.play().catch(() => {});
      else audio.pause();
    });
    root.querySelector('[data-mp-prev]')?.addEventListener('click', () => select(nextIndex(-1), !audio.paused));
    root.querySelector('[data-mp-next]')?.addEventListener('click', () => select(nextIndex(1), !audio.paused));
    modeButton.addEventListener('click', () => {
      const order: PlayMode[] = ['order', 'random', 'single'];
      applyMode(order[(order.indexOf(mode) + 1) % order.length]);
    });
    volumeInput.addEventListener('input', () => { audio.volume = Number(volumeInput.value) / 100; saveState(!audio.paused); });
    toggle.addEventListener('click', () => {
      root.dataset.collapsed = root.dataset.collapsed === 'true' ? 'false' : 'true';
      saveState(!audio.paused);
    });
    progress.addEventListener('click', (event) => {
      if (!audio.duration) return;
      const rect = progress.getBoundingClientRect();
      audio.currentTime = ((event.clientX - rect.left) / rect.width) * audio.duration;
    });

    // 定期记住播放位置，刷新页面后可续播。
    setInterval(() => { if (!audio.paused) saveState(true); }, 5000);
    addEventListener('beforeunload', () => saveState(!audio.paused));

    (async () => {
      const state = loadState();
      root.dataset.collapsed = String(state.collapsed);
      audio.volume = Math.min(1, Math.max(0, state.volume));
      volumeInput.value = String(Math.round(audio.volume * 100));
      applyMode(['order', 'random', 'single'].includes(state.mode) ? state.mode : 'order');
      try {
        const response = await fetch('/api/music', { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        const data = (await response.json()) as { tracks: Track[] };
        tracks = data.tracks || [];
      } catch {
        return;
      }
      if (!tracks.length) return; // music/ 文件夹为空时保持隐藏
      root.hidden = false;
      select(Math.min(state.index, tracks.length - 1), false);
      // 恢复上次进度；若上次正在播放则尝试自动续播（浏览器可能拦截，失败则保持暂停）。
      audio.addEventListener('loadedmetadata', () => { if (state.time > 0) audio.currentTime = state.time; }, { once: true });
      if (state.playing) audio.play().catch(() => {});
    })();
  }
</script>

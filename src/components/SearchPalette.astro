---
// 全局搜索面板：⌘K / Ctrl+K 唤起，复用 FTS5 搜索接口
---

<button class="search-trigger" data-search-trigger type="button" aria-label="搜索文章（Ctrl+K）">
  <span aria-hidden="true">⌕</span><span class="search-trigger-text">搜索</span><kbd>Ctrl K</kbd>
</button>
<dialog class="search-dialog" data-search-dialog aria-label="全局搜索">
  <div class="search-box">
    <input data-search-input type="search" placeholder="搜索文章标题、简介或正文…" maxlength="100" autocomplete="off" />
    <ol class="search-results" data-search-results></ol>
    <p class="search-hint">↑↓ 选择 · Enter 打开 · Esc 关闭</p>
  </div>
</dialog>

<script>
  interface SearchResult { title: string; description: string; url: string; tags: string[] }

  function setupSearchPalette() {
    const trigger = document.querySelector<HTMLButtonElement>('[data-search-trigger]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    if (!trigger || !dialog || trigger.dataset.ready) return;
    trigger.dataset.ready = '1';
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const list = dialog.querySelector<HTMLOListElement>('[data-search-results]')!;
    let results: SearchResult[] = [];
    let active = -1;
    let timer = 0;

    const open = () => { dialog.showModal(); input.value = ''; list.innerHTML = ''; input.focus(); };
    const close = () => dialog.close();

    const render = () => {
      list.innerHTML = '';
      results.forEach((item, index) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = item.url;
        link.className = index === active ? 'active' : '';
        const title = document.createElement('strong');
        title.textContent = item.title;
        const desc = document.createElement('span');
        desc.textContent = item.description;
        link.append(title, desc);
        li.append(link);
        list.append(li);
      });
    };

    const search = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(async () => {
        const q = input.value.trim();
        if (!q) { results = []; active = -1; render(); return; }
        try {
          const response = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
          if (!response.ok) return;
          results = ((await response.json()) as { results: SearchResult[] }).results;
          active = results.length ? 0 : -1;
          render();
        } catch { /* 网络异常时保持现状 */ }
      }, 250);
    };

    trigger.addEventListener('click', open);
    input.addEventListener('input', search);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); active = Math.min(results.length - 1, active + 1); render(); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); active = Math.max(0, active - 1); render(); }
      else if (event.key === 'Enter' && results[active]) { window.location.href = results[active].url; }
    });

    if (!(window as unknown as { __searchHotkey?: boolean }).__searchHotkey) {
      (window as unknown as { __searchHotkey?: boolean }).__searchHotkey = true;
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          const current = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
          if (current) current.open ? current.close() : current.showModal();
          current?.querySelector<HTMLInputElement>('input')?.focus();
        }
      });
    }
  }
  document.addEventListener('astro:page-load', setupSearchPalette);
</script>

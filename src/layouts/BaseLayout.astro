---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getViewer } from '../lib/auth';
import { siteConfig } from '../config/site';
import { absoluteUrl, serializeJsonLd } from '../lib/seo';
import MusicPlayer from '../components/MusicPlayer.astro';
import SearchPalette from '../components/SearchPalette.astro';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  canonicalPath?: string;
  image?: string;
  pageType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { title, description = siteConfig.description, robots, canonicalPath, image = siteConfig.defaultOgImage, pageType = 'website', jsonLd } = Astro.props;
const pageTitle = title === '首页' ? siteConfig.name : `${title} · ${siteConfig.author}`;
const canonical = absoluteUrl(canonicalPath || Astro.url.pathname, Astro.url);
const imageUrl = absoluteUrl(image, Astro.url);
const pathname = Astro.url.pathname;
const viewer = getViewer(Astro.cookies);
---

<!doctype html>
<html lang="zh-CN" data-theme="ark">
  <head>
    <script is:inline>
      try {
        const theme = localStorage.getItem('blog-theme');
        if (theme === 'paper' || theme === 'ark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={pageType} /><meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={imageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div class="site-shell">
      <header class="site-header container">
        <a class="brand" href="/" aria-label="返回首页"><span class="brand-mark">//</span><span>{siteConfig.author}</span><small>PERSONAL ARCHIVE</small></a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}><span>01</span>首页</a>
          <a href="/projects/" aria-current={pathname.startsWith('/projects/') ? 'page' : undefined}><span>02</span>作品</a>
          <a href="/blog/" aria-current={pathname.startsWith('/blog/') ? 'page' : undefined}><span>03</span>文章</a>
          <a href="/updates/" aria-current={pathname.startsWith('/updates/') ? 'page' : undefined}><span>04</span>动态</a>
          <a href="/resources/" aria-current={pathname.startsWith('/resources/') ? 'page' : undefined}><span>05</span>资源库</a>
          <a href="/about/" aria-current={pathname.startsWith('/about/') ? 'page' : undefined}><span>06</span>关于</a>
        </nav>
        <div class="header-tools">
          <SearchPalette />
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换博客主题">◐ <span>主题</span></button>
          {viewer ? <>
            {viewer.role === 'admin' && <a class="account-link" href="/admin/">后台</a>}
            <a class="account-name" href="/account/" title="我的账号">{viewer.avatar ? <img class="avatar avatar-small" src={viewer.avatar} alt="" /> : null}{viewer.username}</a>
            <form action="/api/auth/logout" method="post"><button class="logout-link" type="submit">退出</button></form>
          </> : <a class="account-link" href="/login/">登录</a>}
        </div>
      </header>

      <main id="main-content"><slot /></main>

      <footer class="site-footer container">
        <span>{siteConfig.footer}</span>
        <nav class="footer-links" aria-label="更多页面">
          <a href="/guestbook/">留言墙</a>
          <a href="/resources/">资源库</a>
          <a href="/blog/series/">文库</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        {siteConfig.socialLinks.length > 0 && <nav class="footer-links footer-social" aria-label="社交链接">
          {siteConfig.socialLinks.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
        </nav>}
        <span>© {new Date().getFullYear()} {siteConfig.author}</span>
      </footer>
    </div>
    <MusicPlayer />
    <script is:inline>
      const toggle = document.querySelector('[data-theme-toggle]');
      if (toggle) {
        const update = () => {
          const ark = document.documentElement.dataset.theme === 'ark';
          toggle.setAttribute('aria-label', ark ? '切换到阅读主题' : '切换到档案主题');
          toggle.querySelector('span').textContent = ark ? '阅读' : '档案';
        };
        update();
        toggle.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'ark' ? 'paper' : 'ark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('blog-theme', next); } catch {}
          update();
        });
      }
    </script>
  </body>
</html>

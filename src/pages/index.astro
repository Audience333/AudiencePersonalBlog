---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import { listApprovedResources, listFeaturedProjects, listUpdates } from '../lib/db';
import { countPostWords, countPostImages, listPublicPosts } from '../lib/posts';
import { estimateReadingMinutes } from '../lib/reading';

const posts = listPublicPosts({ pageSize: 3 }).items;
const projects = listFeaturedProjects().slice(0, 2);
const updates = listUpdates().slice(0, 4);
const resources = listApprovedResources().slice(0, 5);
const formatDate = (date: string) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
---

<BaseLayout title="首页" description="一个展示作品、分享文章与记录成长的个人网站。">
  <div class="container">
    <div class="layout-with-sidebar home-layout">
    <ProfileSidebar />
    <div class="layout-main">
    <section class="archive-hero">
      <picture>
        <source srcset="/archive-hero-v1.webp" type="image/webp" />
        <img class="archive-hero-image" src="/archive-hero-v1.png" alt="" width="1920" height="1080" />
      </picture>
      <div class="archive-identity"><strong>观众</strong><span>PERSONAL ARCHIVE<br />CREATIVE RECORDS</span></div>
      <div class="archive-hero-copy">
        <p class="eyebrow">ARCHIVE / SELECT · 2026</p>
        <h1>记录想法，<br /><span class="accent">留下作品。</span></h1>
        <p class="hero-lead">这里收录我做过的项目、写下的文章，以及仍在学习的过程。</p>
        <div class="hero-actions">
          <a class="button-link" href="/projects/">浏览作品 <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/about/">了解更多 →</a>
        </div>
      </div>
      <div class="archive-file-panel">
        <p>PERSONAL DATABASE / 观众档案</p>
        <strong>FILE NO. GZ-001</strong>
        <span>WORKS · NOTES · EXPERIMENTS</span>
      </div>
      <div class="pika-record" aria-label="皮卡丘档案徽章">
        <span class="pika-portrait"><img src="/pikachu-official.png" alt="" /></span>
        <span>PIKA RECORD<br /><strong>025 / ACTIVE</strong></span>
      </div>
      <div class="archive-controls" aria-hidden="true"><span>01 / 08</span><i></i><b>↓</b><small>SESSION AUTHORIZED</small></div>
    </section>

    <section class="section" aria-labelledby="featured-projects">
      <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2 id="featured-projects">最近的作品</h2></div><a class="text-link" href="/projects/">全部作品 →</a></div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <a class={`project-card${project.cover_image ? ' has-cover' : ''}`} href={`/projects/${project.slug}/`}>
            <span class="card-index">PROJECT / {String(index + 1).padStart(2, '0')}</span>
            {project.cover_image && <img class="project-cover" src={project.cover_image} alt="" />}
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="card-bottom"><span>{project.year} · {(JSON.parse(project.tools_json) as string[]).join(' / ')}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="recent-posts">
      <div class="section-heading"><div><p class="eyebrow">LATEST WRITING</p><h2 id="recent-posts">最近的文章</h2></div><a class="text-link" href="/blog/">全部文章 →</a></div>
      <div class="article-list">
        {posts.map((post) => (
          <a class="article-item" href={`/blog/${post.slug}/`}>
            <time class="article-date" datetime={post.published_at}>{formatDate(post.published_at)}</time>
            <div><h3>{post.title}</h3><p>{post.description}</p><p class="article-stats muted">{countPostWords(post.body_markdown).toLocaleString('zh-CN')} 字 · {countPostImages(post.body_markdown)} 图 · 约 {estimateReadingMinutes(post.body_markdown)} 分钟</p></div>
            <span class="article-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    {updates.length > 0 && <section class="section" aria-labelledby="recent-updates">
      <div class="section-heading"><div><p class="eyebrow">UPDATES</p><h2 id="recent-updates">最新动态</h2></div><a class="text-link" href="/updates/">全部动态 →</a></div>
      <ol class="update-timeline update-timeline-compact">
        {updates.map((entry) => (
          <li class="update-item">
            <time datetime={new Date(entry.created_at).toISOString()}>{new Date(entry.created_at).toLocaleDateString('zh-CN')}</time>
            <p class="update-excerpt">{entry.body.replace(/[#*`>\[\]!]/g, '').slice(0, 80)}{entry.body.length > 80 ? '…' : ''}</p>
          </li>
        ))}
      </ol>
    </section>}

    <section class="section" aria-labelledby="resource-hub">
      <div class="section-heading"><div><p class="eyebrow">RESOURCE HUB</p><h2 id="resource-hub">资源库</h2></div><a class="text-link" href="/resources/">全部资源 →</a></div>
      {resources.length ? <div class="friend-grid">
        {resources.map((item) => (
          <a class="friend-card" href={item.url} target="_blank" rel="noopener noreferrer">
            <strong>{item.recommended ? '★ ' : ''}{item.title}</strong>
            {item.description && <span>{item.description.slice(0, 60)}{item.description.length > 60 ? '…' : ''}</span>}
          </a>
        ))}
      </div> : <p class="empty-note">还没有收录的资源。欢迎到<a class="text-link" href="/resources/">资源库</a>提交你珍藏的站点与工具。</p>}
    </section>
    </div>
    </div>
  </div>
</BaseLayout>

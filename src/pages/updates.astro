---
import BaseLayout from '../layouts/BaseLayout.astro';
import { listUpdates } from '../lib/db';
import { renderMarkdown } from '../lib/markdown';
import { formatZonedDateTime } from '../lib/time';
import { siteConfig } from '../config/site';

const tab = Astro.url.searchParams.get('tab') === 'tech' ? 'tech' : 'site';
const entries = listUpdates(tab);
const rendered = await Promise.all(entries.map(async (entry) => ({
  ...entry,
  html: await renderMarkdown(entry.body),
})));
---

<BaseLayout title="动态" description="网站最近的更新与想法。">
  <div class="container">
    <header class="page-head"><p class="eyebrow">UPDATES</p><h1>动态</h1><p>网站的更新记录、即时的想法，以及值得一看的科技资讯。</p></header>
    <nav class="tag-index" aria-label="动态分类">
      <a href="/updates/" class:list={{ active: tab === 'site' }}>网站动态</a>
      <a href="/updates/?tab=tech" class:list={{ active: tab === 'tech' }}>科技资讯</a>
    </nav>
    {rendered.length ? <ol class="update-timeline">
      {rendered.map((entry) => (
        <li class="update-item">
          <time datetime={new Date(entry.created_at).toISOString()}>{formatZonedDateTime(entry.created_at, siteConfig.timezone)}</time>
          <div class="update-body prose-lite" set:html={entry.html} />
        </li>
      ))}
    </ol> : <p class="empty-note">这里还没有内容。</p>}
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这份档案不存在或已被移走。" robots="noindex, nofollow">
  <div class="container">
    <section class="not-found" aria-labelledby="not-found-title">
      <p class="eyebrow">ARCHIVE ERROR</p>
      <h1 id="not-found-title"><span class="not-found-code">404</span>档案不存在</h1>
      <p class="muted">你找的页面可能已被归档、改名，或从未写入这座档案馆。</p>
      <div class="not-found-actions">
        <a class="button-link" href="/">回到首页 <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/blog/">翻翻文章 →</a>
        <a class="text-link" href="/projects/">看看作品 →</a>
      </div>
    </section>
  </div>
</BaseLayout>

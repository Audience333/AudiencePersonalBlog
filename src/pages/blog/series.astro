---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileSidebar from '../../components/ProfileSidebar.astro';
import { countPostWords, listAllPublicPosts, parsePostTags } from '../../lib/posts';
import { estimateReadingMinutes } from '../../lib/reading';

// 文库：把文章按系列汇成系统性的长篇资料
const posts = listAllPublicPosts();
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  if (!post.series) continue;
  const list = groups.get(post.series) ?? [];
  list.push(post);
  groups.set(post.series, list);
}
const series = [...groups].map(([name, items]) => {
  items.sort((a, b) => a.series_order - b.series_order || a.published_at.localeCompare(b.published_at));
  const words = items.reduce((sum, item) => sum + countPostWords(item.body_markdown), 0);
  const minutes = items.reduce((sum, item) => sum + estimateReadingMinutes(item.body_markdown), 0);
  const tags = [...new Set(items.flatMap((item) => parsePostTags(item.tags_json)))];
  return { name, items, words, minutes, tags, updated: items[items.length - 1].published_at };
}).sort((a, b) => b.updated.localeCompare(a.updated));
const totalWords = series.reduce((sum, item) => sum + item.words, 0);
---

<BaseLayout title="文库" description="系统性的系列文章与长篇资料。">
  <div class="container layout-with-sidebar">
    <ProfileSidebar />
    <div class="layout-main">
    <header class="page-head"><p class="eyebrow">LIBRARY</p><h1>文库</h1><p>按系列收纳的长篇内容 · {series.length} 个系列 / {totalWords.toLocaleString('zh-CN')} 字</p></header>
    {series.length ? <div class="library-list">
      {series.map((group) => (
        <details class="library-card">
          <summary>
            <div class="library-head">
              <strong>{group.name}</strong>
              <span class="muted">{group.items.length} 篇 / {group.words.toLocaleString('zh-CN')} 字 / 约 {group.minutes} 分钟</span>
            </div>
            <ul class="pill-list">{group.tags.slice(0, 6).map((tag) => <li><span class="pill">{tag}</span></li>)}</ul>
          </summary>
          <ol class="series-list library-series">
            {group.items.map((post) => <li><a href={`/blog/${post.slug}/`}>{post.title}</a><span class="muted"> · {post.published_at}</span></li>)}
          </ol>
        </details>
      ))}
    </div> : <p class="empty-note">还没有系列文章。在后台编辑文章时填写「所属系列」即可收录到文库。</p>}
    </div>
  </div>
</BaseLayout>

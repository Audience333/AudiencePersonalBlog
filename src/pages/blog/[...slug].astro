---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getViewer } from '../../lib/auth';
import { countLikes, hasLiked, incrementPostView, listApprovedComments, type CommentRow } from '../../lib/db';
import ArticleToc from '../../components/ArticleToc.astro';
import ProfileSidebar from '../../components/ProfileSidebar.astro';
import { renderMarkdownDocument } from '../../lib/reading';
import { findAdjacentPublicPosts, findPublicPostBySlug, findRelatedPublicPosts, listPublicSeriesPosts, parsePostTags } from '../../lib/posts';
import { absoluteUrl, articleJsonLd } from '../../lib/seo';

const post = findPublicPostBySlug(Astro.params.slug || '');
if (!post) return new Response('文章不存在', { status: 404 });
Astro.response.headers.set('Cache-Control', 'no-store');
const viewer = getViewer(Astro.cookies);
// 管理员自己翻看不计入浏览量
const viewCount = viewer?.role === 'admin' ? post.view_count : incrementPostView(post.id);
const document = await renderMarkdownDocument(post.body_markdown);
const tags = parsePostTags(post.tags_json);
const comments = listApprovedComments(post.id);
const likes = countLikes(post.id);
const liked = viewer ? hasLiked(post.id, viewer.id) : false;
const adjacent = findAdjacentPublicPosts(post.id);
const related = findRelatedPublicPosts(post);
const seriesPosts = post.series ? listPublicSeriesPosts(post.series) : [];
const canonicalPath = `/blog/${post.slug}/`;
const formatDate = (date: string) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
const commentMessage: Record<string, string> = { pending: '评论已提交，审核通过后会公开。', invalid: '评论需为 2–1000 字，且回复目标有效。', limited: '评论太频繁，请稍后再试。', closed: '这篇文章暂不接受评论。', blocked: '评论未能通过发布规则。' };
const message = commentMessage[Astro.url.searchParams.get('comment') || ''];
// 顶层评论 + 各自的回复（嵌套一层，按时间正序）
const topLevelComments = comments.filter((comment) => comment.parent_id === null);
const repliesByParent = new Map<number, CommentRow[]>();
for (const comment of comments) {
  if (comment.parent_id === null) continue;
  const list = repliesByParent.get(comment.parent_id) ?? [];
  list.push(comment);
  repliesByParent.set(comment.parent_id, list);
}
const canComment = post.comments_enabled === 1 && viewer;
---

<BaseLayout title={post.title} description={post.description} canonicalPath={canonicalPath} image={post.cover_image || undefined} pageType="article" jsonLd={articleJsonLd(post, absoluteUrl(canonicalPath, Astro.url))}>
  <div class="container layout-with-sidebar">
    <ProfileSidebar />
    <article class="layout-main">
    <header class="article-header">
      <a class="back-link" href="/blog/">← 返回文章列表</a>
      <h1>{post.title}</h1>
      <p class="article-meta"><time datetime={post.published_at}>{formatDate(post.published_at)}</time> · 约 {document.readingMinutes} 分钟阅读 · 阅读 {viewCount} 次</p>
      <ul class="pill-list">{tags.map((tag) => <li><a class="pill" href={`/blog/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>)}</ul>
    </header>
    {document.headings.length >= 2 && <ArticleToc headings={document.headings} />}
    <progress class="reading-progress" value="0" max="1" aria-hidden="true"></progress>
    <div class="danmaku-layer" data-danmaku-layer aria-hidden="true"></div>
    <div class="prose" set:html={document.html} />
    {seriesPosts.length > 1 && post.series && (
      <nav class="series-box" aria-label="所属系列">
        <p class="series-title">系列「{post.series}」 · 第 {seriesPosts.findIndex((item) => item.id === post.id) + 1} / {seriesPosts.length} 篇</p>
        <ol class="series-list">
          {seriesPosts.map((item) => (
            <li class:list={{ current: item.id === post.id }}>
              {item.id === post.id ? <span>{item.title}（本篇）</span> : <a href={`/blog/${item.slug}/`}>{item.title}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {(adjacent.previous || adjacent.next) && <nav class="article-navigation" aria-label="文章导航">{adjacent.previous ? <a href={`/blog/${adjacent.previous.slug}/`}>← 较早：{adjacent.previous.title}</a> : <span />}{adjacent.next ? <a href={`/blog/${adjacent.next.slug}/`}>较新：{adjacent.next.title} →</a> : <span />}</nav>}
    {related.length > 0 && (
      <section class="related-posts" aria-labelledby="related-title">
        <h2 id="related-title">相关阅读</h2>
        <div class="related-list">
          {related.map((item) => (
            <a class="related-card" href={`/blog/${item.slug}/`}>
              <strong>{item.title}</strong>
              <span>{item.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <div class="post-actions" id="reactions">
      {viewer ? <form action="/api/likes" method="post"><input type="hidden" name="slug" value={post.slug} /><button class="small-button secondary-button" type="submit">{liked ? '⚡ 已点赞' : '⚡ 点赞'} · {likes}</button></form> : <a class="text-link" href="/login/">登录后点赞 · {likes}</a>}
      <span class="muted">{comments.length} 条评论</span>
      {viewer && <form class="danmaku-form" data-danmaku-form data-slug={post.slug}><input name="body" maxlength="50" required placeholder="发送弹幕…" /><button class="small-button" type="submit">发射</button></form>}
    </div>
    <section class="comment-section" id="comments" aria-labelledby="comment-title">
      <h2 id="comment-title">讨论</h2>
      {message && <p class={message.includes('已提交') ? 'form-success' : 'form-error'} role="status">{message}</p>}
      {topLevelComments.length ? <ol class="comment-list">{topLevelComments.map((comment) => (
        <li class="comment">
          <div class="comment-header"><strong>{comment.avatar && <img class="avatar avatar-small" src={comment.avatar} alt="" />}{comment.username}</strong><span>{new Date(comment.created_at).toLocaleDateString('zh-CN')}</span></div>
          <p>{comment.body}</p>
          {canComment && <details class="reply-box"><summary>回复</summary><form class="comment-form reply-form" action="/api/comments" method="post"><input type="hidden" name="slug" value={post.slug} /><input type="hidden" name="parent_id" value={comment.id} /><label class="field">回复 {comment.username}<textarea name="body" rows="3" minlength="2" maxlength="1000" required placeholder="写下你的回复…"></textarea></label><button class="small-button" type="submit">提交回复</button></form></details>}
          {(repliesByParent.get(comment.id) ?? []).length > 0 && <ol class="comment-list comment-children">
            {(repliesByParent.get(comment.id) ?? []).map((reply) => (
              <li class="comment">
                <div class="comment-header"><strong>{reply.avatar && <img class="avatar avatar-small" src={reply.avatar} alt="" />}{reply.username}</strong><span class="muted">回复 {comment.username}</span><span>{new Date(reply.created_at).toLocaleDateString('zh-CN')}</span></div>
                <p>{reply.body}</p>
              </li>
            ))}
          </ol>}
        </li>
      ))}</ol> : <p class="muted">还没有公开评论，来留下第一条想法吧。</p>}
      {post.comments_enabled !== 1 ? <p class="muted">这篇文章暂不接受新评论。</p> : viewer ? <form class="comment-form" action="/api/comments" method="post"><input type="hidden" name="slug" value={post.slug} /><label class="field">以 {viewer.username} 的身份评论<textarea name="body" rows="5" minlength="2" maxlength="1000" required placeholder="写下你的想法…"></textarea></label><button class="primary-button" type="submit">提交评论</button><p class="form-note">评论将在管理员审核后显示。</p></form> : <p><a class="text-link" href="/login/">登录</a>或<a class="text-link" href="/register/">注册</a>后可以评论和点赞。</p>}
    </section>
    </article>
  </div>
</BaseLayout>

<script>
  import { enhanceProse } from '../../lib/prose-enhance';

  function setupArticlePage() {
    const article = document.querySelector<HTMLElement>('.prose');
    if (!article) return;
    enhanceProse(article);
    const progress = document.querySelector<HTMLProgressElement>('.reading-progress');
    const updateProgress = () => {
      if (!progress) return;
      const range = Math.max(1, article.offsetHeight - window.innerHeight * 0.45);
      progress.value = Math.min(1, Math.max(0, (window.scrollY - article.offsetTop + window.innerHeight * 0.25) / range));
    };
    // 换页时先移除旧的滚动监听，避免重复绑定。
    const previous = (window as unknown as { __articleScroll?: () => void }).__articleScroll;
    if (previous) removeEventListener('scroll', previous);
    (window as unknown as { __articleScroll?: () => void }).__articleScroll = updateProgress;
    addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
    document.querySelectorAll<HTMLElement>('.prose pre:not([data-copy-ready]):not(.mermaid)').forEach((pre) => {
      pre.dataset.copyReady = '1';
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'code-copy'; button.textContent = '复制代码';
      button.addEventListener('click', async () => { await navigator.clipboard.writeText(pre.innerText); button.textContent = '已复制'; setTimeout(() => { button.textContent = '复制代码'; }, 1500); });
      pre.prepend(button);
    });
    setupReadingMemory(article);
    setupDanmaku();
  }

  // ===== 阅读位置记忆 =====
  function setupReadingMemory(article: HTMLElement) {
    const key = `reading-pos:${location.pathname}`;
    const save = () => {
      const ratio = Math.min(1, Math.max(0, (window.scrollY - article.offsetTop) / Math.max(1, article.offsetHeight)));
      try { localStorage.setItem(key, JSON.stringify({ ratio, at: Date.now() })); } catch {}
    };
    let saveTimer = 0;
    const throttledSave = () => { window.clearTimeout(saveTimer); saveTimer = window.setTimeout(save, 800); };
    const previous = (window as unknown as { __readingSave?: () => void }).__readingSave;
    if (previous) removeEventListener('scroll', previous);
    (window as unknown as { __readingSave?: () => void }).__readingSave = throttledSave;
    addEventListener('scroll', throttledSave, { passive: true });

    // 上次读到 10%–95% 之间时提示续读
    let saved: { ratio: number } | null = null;
    try { saved = JSON.parse(localStorage.getItem(key) || 'null'); } catch {}
    if (!saved || saved.ratio < 0.1 || saved.ratio > 0.95) return;
    if (document.querySelector('[data-reading-resume]')) return;
    const toast = document.createElement('div');
    toast.className = 'reading-resume';
    toast.dataset.readingResume = '1';
    const label = document.createElement('span');
    label.textContent = `上次读到 ${Math.round(saved.ratio * 100)}%`;
    const jump = document.createElement('button');
    jump.type = 'button'; jump.textContent = '继续阅读';
    jump.addEventListener('click', () => {
      window.scrollTo({ top: article.offsetTop + article.offsetHeight * saved!.ratio, behavior: 'smooth' });
      toast.remove();
    });
    const dismiss = document.createElement('button');
    dismiss.type = 'button'; dismiss.textContent = '×'; dismiss.setAttribute('aria-label', '关闭');
    dismiss.addEventListener('click', () => toast.remove());
    toast.append(label, jump, dismiss);
    document.body.append(toast);
    setTimeout(() => toast.remove(), 12000);
  }

  // ===== 弹幕 =====
  let danmakuTimer = 0;
  function setupDanmaku() {
    const layer = document.querySelector<HTMLElement>('[data-danmaku-layer]');
    if (!layer) return;
    window.clearInterval(danmakuTimer);
    const form = document.querySelector<HTMLFormElement>('[data-danmaku-form]');
    const slug = form?.dataset.slug || location.pathname.replace(/^\/blog\/|\/$/g, '');
    let queue: string[] = [];

    const shoot = (text: string) => {
      const item = document.createElement('span');
      item.className = 'danmaku-item';
      item.textContent = text;
      item.style.top = `${Math.floor(Math.random() * 12) * 7}%`;
      item.style.animationDuration = `${9 + Math.random() * 5}s`;
      layer.append(item);
      item.addEventListener('animationend', () => item.remove());
    };

    (async () => {
      try {
        const response = await fetch(`/api/danmaku?slug=${encodeURIComponent(slug)}`);
        if (!response.ok) return;
        const data = (await response.json()) as { items: Array<{ body: string }> };
        queue = data.items.map((item) => item.body);
      } catch { return; }
      if (!queue.length) return;
      shoot(queue[Math.floor(Math.random() * queue.length)]);
      danmakuTimer = window.setInterval(() => {
        if (document.hidden || !queue.length || !document.body.contains(layer)) return;
        shoot(queue[Math.floor(Math.random() * queue.length)]);
      }, 2600);
    })();

    if (form && !form.dataset.ready) {
      form.dataset.ready = '1';
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const input = form.querySelector<HTMLInputElement>('input[name="body"]')!;
        const body = input.value.trim();
        if (!body) return;
        const data = new URLSearchParams({ slug, body });
        const response = await fetch('/api/danmaku', { method: 'POST', body: data });
        const result = await response.json().catch(() => ({}));
        if (response.ok) { shoot(body); queue.push(body); input.value = ''; }
        else input.placeholder = result.error || '发送失败';
      });
    }
  }

  document.addEventListener('astro:page-load', setupArticlePage);
</script>

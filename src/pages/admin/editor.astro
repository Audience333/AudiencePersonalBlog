---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getViewer } from '../../lib/auth';
import { findPostById } from '../../lib/db';
import { parsePostTags } from '../../lib/posts';
import { getRuntimeSettings } from '../../lib/settings';
import { siteConfig } from '../../config/site';

const viewer = getViewer(Astro.cookies);
if (!viewer) return Astro.redirect('/login/?error=required');
if (viewer.role !== 'admin') return new Response('Forbidden', { status: 403 });
Astro.response.headers.set('Cache-Control', 'no-store');
const id = Number(Astro.url.searchParams.get('id') || 0);
const post = id ? findPostById(id) : undefined;
if (id && !post) return Astro.redirect('/admin/');
const tags = post ? parsePostTags(post.tags_json).join(', ') : '';
const today = new Date().toISOString().slice(0, 10);
const defaultCommentsEnabled = getRuntimeSettings().defaultCommentsEnabled;
const scheduledAt = post?.scheduled_at
  ? new Intl.DateTimeFormat('sv-SE', { timeZone: siteConfig.timezone, dateStyle: 'short', timeStyle: 'short', hourCycle: 'h23' }).format(new Date(post.scheduled_at)).replace(' ', 'T')
  : '';
---

<BaseLayout title={post ? `编辑：${post.title}` : '写新文章'} description="博客文章编辑器。" robots="noindex, nofollow">
  <div class="container dashboard">
    <header class="dashboard-head"><div><a class="back-link" href="/admin/">← 返回后台</a><h1>{post ? '编辑文章' : '写新文章'}</h1><p class="muted">使用 Markdown 写正文，保存后可在文章页查看。</p></div></header>
    {Astro.url.searchParams.get('saved') === '1' && <p class="form-success" role="status">文章已保存。</p>}
    <form id="post-editor" class="editor-grid">
      <input type="hidden" name="id" value={post?.id || ''} />
      <label class="field">标题<input name="title" value={post?.title || ''} required minlength="2" maxlength="100" /></label>
      <label class="field">网址标识<input name="slug" value={post?.slug || ''} required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="80" /><small>例如 my-first-post，保存后网址为 /blog/my-first-post/。</small></label>
      <label class="field editor-wide">简介<input name="description" value={post?.description || ''} required minlength="5" maxlength="240" /></label>
      <label class="field">发布日期<input name="published_at" type="date" value={post?.published_at || today} required /></label>
      <label class="field">状态<select name="status"><option value="draft" selected={post?.status !== 'published'}>草稿</option><option value="published" selected={post?.status === 'published'}>发布</option></select></label>
      <label class="field">计划发布时间<input name="scheduled_at" type="datetime-local" value={scheduledAt} /><small>按 {siteConfig.timezone} 保存；留空会立即按发布状态显示。</small></label>
      <label class="field">封面图片地址<input name="cover_image" type="url" value={post?.cover_image || ''} placeholder="https://… 或已上传图片地址" /></label>
      <label class="field checkbox-field"><input name="archived" type="checkbox" checked={post?.archived === 1} /> 归档，不公开显示</label>
      <label class="field checkbox-field"><input name="comments_enabled" type="checkbox" checked={post ? post.comments_enabled === 1 : defaultCommentsEnabled} /> 允许访客评论</label>
      <label class="field editor-wide">标签<input name="tags" value={tags} placeholder="技术, 随笔" /><small>用英文逗号分隔，最多 8 个。</small></label>
      <div class="field editor-wide"><span>文章图片</span><div class="cover-upload-row"><input id="content-image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><button id="insert-image" class="small-button" type="button">上传并插入</button><span id="image-status" role="status"></span></div><small>图片会插入当前光标位置，使用 Markdown 格式。</small></div>
      <div class="editor-tabs editor-wide" role="tablist" aria-label="编辑模式"><button type="button" role="tab" id="edit-tab" aria-controls="edit-panel" aria-selected="true">编辑</button><button type="button" role="tab" id="preview-tab" aria-controls="preview-panel" aria-selected="false">预览</button></div>
      <div id="edit-panel" class="editor-wide" role="tabpanel" aria-labelledby="edit-tab"><label class="field">Markdown 正文<textarea id="markdown-body" name="body" rows="20" required>{post?.body_markdown || ''}</textarea></label></div>
      <section id="preview-panel" class="editor-preview editor-wide" role="tabpanel" aria-labelledby="preview-tab"><div class="section-heading"><h2 id="preview-title">实时预览</h2></div><div id="markdown-preview" class="prose" aria-live="polite"></div></section>
      <div class="editor-actions editor-wide"><button class="primary-button" type="submit">保存文章</button><span id="save-status" role="status" aria-live="polite"></span></div>
    </form>
    {post?.status === 'published' && <p class="form-note"><a class="text-link" href={`/blog/${post.slug}/`}>查看已发布文章 ↗</a></p>}
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#post-editor');
  const status = document.querySelector<HTMLElement>('#save-status');
  const textarea = document.querySelector<HTMLTextAreaElement>('#markdown-body');
  const preview = document.querySelector<HTMLElement>('#markdown-preview');
  const imageInput = document.querySelector<HTMLInputElement>('#content-image-file');
  const imageStatus = document.querySelector<HTMLElement>('#image-status');
  const insertImage = document.querySelector<HTMLButtonElement>('#insert-image');
  const editTab = document.querySelector<HTMLButtonElement>('#edit-tab');
  const previewTab = document.querySelector<HTMLButtonElement>('#preview-tab');
  const editPanel = document.querySelector<HTMLElement>('#edit-panel');
  const previewPanel = document.querySelector<HTMLElement>('#preview-panel');
  const mobileEditor = matchMedia('(max-width: 760px)');
  let dirty = false;
  const markDirty = () => { dirty = true; };
  const setPanel = (panel: 'edit' | 'preview') => {
    const isPreview = panel === 'preview';
    editTab?.setAttribute('aria-selected', String(!isPreview));
    previewTab?.setAttribute('aria-selected', String(isPreview));
    if (mobileEditor.matches) {
      if (editPanel) editPanel.hidden = isPreview;
      if (previewPanel) previewPanel.hidden = !isPreview;
    } else {
      if (editPanel) editPanel.hidden = false;
      if (previewPanel) previewPanel.hidden = false;
    }
  };
  let previewTimer = 0;
  const updatePreview = () => {
    window.clearTimeout(previewTimer);
    previewTimer = window.setTimeout(async () => {
      if (!textarea || !preview) return;
      const body = new URLSearchParams({ body: textarea.value });
      const response = await fetch('/api/admin/preview', { method: 'POST', body });
      if (response.ok) preview.innerHTML = (await response.json()).html;
    }, 300);
  };
  textarea?.addEventListener('input', updatePreview);
  form?.addEventListener('input', markDirty);
  form?.addEventListener('change', markDirty);
  form?.addEventListener('invalid', () => setPanel('edit'), true);
  editTab?.addEventListener('click', () => setPanel('edit'));
  previewTab?.addEventListener('click', () => setPanel('preview'));
  mobileEditor.addEventListener('change', () => setPanel(previewTab?.getAttribute('aria-selected') === 'true' ? 'preview' : 'edit'));
  addEventListener('beforeunload', (event) => { if (dirty) event.preventDefault(); });
  setPanel('edit');
  updatePreview();
  insertImage?.addEventListener('click', async () => {
    const file = imageInput?.files?.[0];
    if (!file || !textarea || !imageStatus) { if (imageStatus) imageStatus.textContent = '请先选择图片。'; return; }
    imageStatus.textContent = '正在上传…';
    const data = new FormData(); data.set('image', file);
    const response = await fetch('/api/admin/uploads', { method: 'POST', body: data });
    const result = await response.json();
    if (!response.ok) { imageStatus.textContent = result.error || '上传失败。'; return; }
    const start = textarea.selectionStart; const end = textarea.selectionEnd;
    textarea.setRangeText(`![图片说明](${result.url})`, start, end, 'end'); textarea.focus(); markDirty(); imageStatus.textContent = '图片已插入。'; updatePreview();
  });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;
    status.textContent = '正在保存…';
    const body = new URLSearchParams();
    new FormData(form).forEach((value, key) => body.set(key, String(value)));
    try {
      const response = await fetch('/api/admin/posts', { method: 'POST', body });
      const result = await response.json();
      if (!response.ok) { status.textContent = result.error || '保存失败。'; return; }
      dirty = false;
      window.location.assign(`${result.location}&saved=1`);
    } catch {
      status.textContent = '网络错误，文章尚未保存，请重试。';
    }
  });
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getViewer } from '../../lib/auth';
import { findProjectById } from '../../lib/db';

const viewer = getViewer(Astro.cookies);
if (!viewer) return Astro.redirect('/login/?error=required');
if (viewer.role !== 'admin') return new Response('Forbidden', { status: 403 });
Astro.response.headers.set('Cache-Control', 'no-store');
const id = Number(Astro.url.searchParams.get('id') || 0);
const project = id ? findProjectById(id) : undefined;
if (id && !project) return Astro.redirect('/admin/');
const tools = project ? JSON.parse(project.tools_json).join(', ') : '';
const year = project?.year || new Date().getFullYear();
---

<BaseLayout title={project ? `编辑：${project.title}` : '上传作品'} description="作品上传与编辑器。">
  <div class="container dashboard">
    <header class="dashboard-head"><div><a class="back-link" href="/admin/">← 返回后台</a><h1>{project ? '编辑作品' : '上传作品'}</h1><p class="muted">填写作品信息和 Markdown 正文；封面图可选，上传后会自动放入本机数据目录。</p></div></header>
    {Astro.url.searchParams.get('saved') === '1' && <p class="form-success" role="status">作品已保存。</p>}
    <form id="project-editor" class="editor-grid">
      <input type="hidden" name="id" value={project?.id || ''} />
      <input id="cover-image" type="hidden" name="cover_image" value={project?.cover_image || ''} />
      <label class="field">作品标题<input name="title" value={project?.title || ''} required minlength="2" maxlength="100" /></label>
      <label class="field">网址标识<input name="slug" value={project?.slug || ''} required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="80" /><small>例如 my-portfolio，网址为 /projects/my-portfolio/。</small></label>
      <label class="field editor-wide">简短介绍<input name="description" value={project?.description || ''} required minlength="5" maxlength="240" /></label>
      <label class="field">完成年份<input name="year" type="number" value={year} min="1900" max="2100" required /></label>
      <label class="field">状态<select name="status"><option value="draft" selected={project?.status !== 'published'}>草稿</option><option value="published" selected={project?.status === 'published'}>发布</option></select></label>
      <label class="field editor-wide">使用工具<input name="tools" value={tools} placeholder="Astro, CSS, Figma" /><small>用英文逗号分隔，最多 10 个。</small></label>
      <label class="field editor-wide checkbox-field"><input name="featured" type="checkbox" checked={project?.featured === 1} /> 在首页“最近的作品”展示</label>
      <div class="field editor-wide cover-uploader">
        <span>封面图（可选）</span>
        <div class="cover-upload-row"><input id="cover-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" /><button id="upload-cover" class="small-button" type="button">上传封面</button><span id="upload-status" role="status" aria-live="polite"></span></div>
        <small>支持 PNG、JPG、WebP 或 GIF，文件不超过 4 MB。图片上传后会用于作品卡片和详情页。</small>
        <div id="cover-preview" class="cover-preview" data-empty={!project?.cover_image}>{project?.cover_image ? <img src={project.cover_image} alt="当前作品封面" /> : <span>还没有上传封面</span>}</div>
      </div>
      <label class="field editor-wide">作品 Markdown 正文<textarea name="body" rows="20" required>{project?.body_markdown || ''}</textarea></label>
      <div class="editor-actions editor-wide"><button class="primary-button" type="submit">保存作品</button><span id="save-status" role="status" aria-live="polite"></span></div>
    </form>
    {project?.status === 'published' && <p class="form-note"><a class="text-link" href={`/projects/${project.slug}/`}>查看已发布作品 ↗</a></p>}
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#project-editor');
  const saveStatus = document.querySelector<HTMLElement>('#save-status');
  const uploadStatus = document.querySelector<HTMLElement>('#upload-status');
  const fileInput = document.querySelector<HTMLInputElement>('#cover-file');
  const coverInput = document.querySelector<HTMLInputElement>('#cover-image');
  const preview = document.querySelector<HTMLElement>('#cover-preview');
  const uploadButton = document.querySelector<HTMLButtonElement>('#upload-cover');

  uploadButton?.addEventListener('click', async () => {
    const file = fileInput?.files?.[0];
    if (!file || !uploadStatus || !coverInput || !preview) { if (uploadStatus) uploadStatus.textContent = '请先选择一张图片。'; return; }
    if (file.size > 4 * 1024 * 1024) { uploadStatus.textContent = '图片不能超过 4 MB。'; return; }
    uploadStatus.textContent = '正在上传…';
    uploadButton.disabled = true;
    const data = new FormData();
    data.set('image', file);
    try {
      const response = await fetch('/api/admin/uploads', { method: 'POST', body: data });
      const result = await response.json();
      if (!response.ok) { uploadStatus.textContent = result.error || '上传失败。'; return; }
      coverInput.value = result.url;
      preview.innerHTML = '';
      const image = document.createElement('img');
      image.src = result.url;
      image.alt = '新上传的作品封面';
      preview.append(image);
      preview.dataset.empty = 'false';
      uploadStatus.textContent = '封面已上传，保存作品后生效。';
    } catch {
      uploadStatus.textContent = '网络错误，上传失败，请重试。';
    } finally {
      uploadButton.disabled = false;
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!saveStatus) return;
    saveStatus.textContent = '正在保存…';
    const body = new URLSearchParams();
    new FormData(form).forEach((value, key) => {
      if (value instanceof File) return;
      body.set(key, String(value));
    });
    try {
      const response = await fetch('/api/admin/projects', { method: 'POST', body });
      const result = await response.json();
      if (!response.ok) { saveStatus.textContent = result.error || '保存失败。'; return; }
      window.location.assign(`${result.location}&saved=1`);
    } catch {
      saveStatus.textContent = '网络错误，作品尚未保存，请重试。';
    }
  });
</script>

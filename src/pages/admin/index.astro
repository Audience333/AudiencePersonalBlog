---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getViewer } from '../../lib/auth';
import { listAllPosts, listAllProjects, listPendingComments, listPendingGuestbook, listPendingResources, listRecentDanmaku, listUpdates } from '../../lib/db';
import { resolvePostState } from '../../lib/posts';
import { formatZonedDateTime } from '../../lib/time';
import { siteConfig } from '../../config/site';

const viewer = getViewer(Astro.cookies);
if (!viewer) return Astro.redirect('/login/?error=required');
if (viewer.role !== 'admin') return new Response('Forbidden', { status: 403 });
Astro.response.headers.set('Cache-Control', 'no-store');
const posts = listAllPosts();
const projects = listAllProjects();
const comments = listPendingComments();
const guestbook = listPendingGuestbook();
const resources = listPendingResources();
const updates = listUpdates().slice(0, 20);
const danmaku = listRecentDanmaku(20);
---

<BaseLayout title="管理后台" description="管理作品、文章与评论。" robots="noindex, nofollow">
  <div class="container dashboard">
    <header class="dashboard-head">
      <div><p class="eyebrow">CONTROL PANEL</p><h1>内容后台</h1><p class="muted">你好，{viewer.username}。保存并发布后，作品与文章会直接更新网站。</p></div>
      <div class="dashboard-actions"><a class="button-link" href="/admin/project-editor/">上传作品 <span aria-hidden="true">↗</span></a><a class="text-link" href="/admin/editor/">写新文章 →</a><a class="text-link" href="/admin/stats/">访问统计 →</a><a class="text-link" href="/admin/settings/">网站设置 →</a></div>
    </header>

    <section class="dashboard-section" aria-labelledby="projects-title">
      <div class="section-heading"><h2 id="projects-title">作品</h2><span class="muted">{projects.length} 个</span></div>
      <div class="dashboard-list">
        {projects.map((project) => <div class="dashboard-row">
          <div><strong>{project.title}</strong><p>{project.status === 'published' ? '已发布' : '草稿'} · {project.year} · /projects/{project.slug}/</p></div>
          <div class="row-actions"><a class="text-link" href={`/admin/project-editor/?id=${project.id}`}>编辑 →</a>{project.status === 'published' && <a class="text-link" href={`/projects/${project.slug}/`}>查看 ↗</a>}</div>
        </div>)}
      </div>
    </section>

    <section class="dashboard-section" aria-labelledby="posts-title">
      <div class="section-heading"><h2 id="posts-title">文章</h2><span class="muted">{posts.length} 篇</span></div>
      <div class="dashboard-list">
        {posts.map((post) => <div class="dashboard-row">
          <div><strong>{post.title}</strong><p>{({ draft: '草稿', scheduled: `计划发布 · ${formatZonedDateTime(post.scheduled_at!, siteConfig.timezone)}`, published: '已发布', archived: '已归档' })[resolvePostState(post)]} · {post.published_at} · 阅读 {post.view_count} 次{post.series ? ` · 系列「${post.series}」` : ''} · /blog/{post.slug}/</p></div>
          <div class="row-actions"><a class="text-link" href={`/admin/editor/?id=${post.id}`}>编辑 →</a>{resolvePostState(post) === 'published' && <a class="text-link" href={`/blog/${post.slug}/`}>查看 ↗</a>}</div>
        </div>)}
      </div>
    </section>

    <section class="dashboard-section" id="updates" aria-labelledby="updates-title">
      <div class="section-heading"><h2 id="updates-title">动态</h2><span class="muted">发布到 /updates/</span></div>
      <form class="update-admin-form" action="/api/admin/updates" method="post">
        <label class="field">内容（支持 Markdown）<textarea name="body" rows="3" minlength="2" maxlength="2000" required placeholder="记录一次更新、一个想法…"></textarea></label>
        <div class="update-admin-row">
          <label class="field">分类<select name="kind"><option value="site">网站动态</option><option value="tech">科技资讯</option></select></label>
          <button class="small-button" type="submit">发布动态</button>
        </div>
      </form>
      {updates.length > 0 && <div class="dashboard-list">
        {updates.map((entry) => <div class="dashboard-row">
          <div><p>{entry.body.slice(0, 80)}{entry.body.length > 80 ? '…' : ''}</p><p class="muted">{entry.kind === 'tech' ? '科技资讯' : '网站动态'} · {formatZonedDateTime(entry.created_at, siteConfig.timezone)}</p></div>
          <div class="row-actions"><form action="/api/admin/updates" method="post"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={entry.id} /><button class="small-button secondary-button" type="submit">删除</button></form></div>
        </div>)}
      </div>}
    </section>

    <section class="dashboard-section" id="comments" aria-labelledby="comments-title">
      <div class="section-heading"><h2 id="comments-title">待审核评论</h2><span class="muted">{comments.length} 条</span></div>
      {comments.length ? <div class="dashboard-list">
        {comments.map((comment) => <div class="dashboard-row">
          <div><strong>{comment.username}</strong><p>评论于《{comment.post_title}》{comment.parent_id ? ' · 回复' : ''}</p><p>{comment.body}</p></div>
          <div class="row-actions">
            <form action="/api/admin/comments" method="post"><input type="hidden" name="id" value={comment.id} /><input type="hidden" name="status" value="approved" /><button class="small-button" type="submit">通过</button></form>
            <form action="/api/admin/comments" method="post"><input type="hidden" name="id" value={comment.id} /><input type="hidden" name="status" value="rejected" /><button class="small-button secondary-button" type="submit">拒绝</button></form>
          </div>
        </div>)}
      </div> : <p class="empty-note">目前没有待审核评论。</p>}
    </section>

    <section class="dashboard-section" id="guestbook" aria-labelledby="guestbook-title">
      <div class="section-heading"><h2 id="guestbook-title">待审核留言</h2><span class="muted">{guestbook.length} 条</span></div>
      {guestbook.length ? <div class="dashboard-list">
        {guestbook.map((entry) => <div class="dashboard-row">
          <div><strong>{entry.nickname}</strong><p>{entry.body}</p></div>
          <div class="row-actions">
            <form action="/api/admin/guestbook" method="post"><input type="hidden" name="id" value={entry.id} /><input type="hidden" name="status" value="approved" /><button class="small-button" type="submit">通过</button></form>
            <form action="/api/admin/guestbook" method="post"><input type="hidden" name="id" value={entry.id} /><input type="hidden" name="status" value="rejected" /><button class="small-button secondary-button" type="submit">拒绝</button></form>
          </div>
        </div>)}
      </div> : <p class="empty-note">目前没有待审核留言。</p>}
    </section>

    <section class="dashboard-section" id="resources" aria-labelledby="resources-title">
      <div class="section-heading"><h2 id="resources-title">待审核资源投稿</h2><span class="muted">{resources.length} 条</span></div>
      {resources.length ? <div class="dashboard-list">
        {resources.map((resource) => <div class="dashboard-row">
          <div><strong>{resource.title}</strong><p>{resource.submitter} 投稿{resource.url ? ` · ${resource.url}` : ''}</p><p>{resource.description}</p></div>
          <div class="row-actions">
            <form action="/api/admin/resources" method="post"><input type="hidden" name="id" value={resource.id} /><input type="hidden" name="action" value="approved" /><button class="small-button" type="submit">通过</button></form>
            <form action="/api/admin/resources" method="post"><input type="hidden" name="id" value={resource.id} /><input type="hidden" name="action" value="recommend" /><button class="small-button" type="submit">通过并推荐</button></form>
            <form action="/api/admin/resources" method="post"><input type="hidden" name="id" value={resource.id} /><input type="hidden" name="action" value="rejected" /><button class="small-button secondary-button" type="submit">拒绝</button></form>
          </div>
        </div>)}
      </div> : <p class="empty-note">目前没有待审核资源。</p>}
    </section>

    <section class="dashboard-section" id="danmaku" aria-labelledby="danmaku-title">
      <div class="section-heading"><h2 id="danmaku-title">最新弹幕</h2><span class="muted">{danmaku.length} 条</span></div>
      {danmaku.length ? <div class="dashboard-list">
        {danmaku.map((item) => <div class="dashboard-row">
          <div><strong>{item.username}</strong><p>《{item.post_title}》：{item.body}</p></div>
          <div class="row-actions"><form action="/api/admin/danmaku" method="post"><input type="hidden" name="id" value={item.id} /><button class="small-button secondary-button" type="submit">删除</button></form></div>
        </div>)}
      </div> : <p class="empty-note">还没有弹幕。</p>}
    </section>
  </div>
</BaseLayout>

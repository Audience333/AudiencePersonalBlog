---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getViewer } from '../lib/auth';
import { listApprovedResources, type ResourceRow } from '../lib/db';

const viewer = getViewer(Astro.cookies);
Astro.response.headers.set('Cache-Control', 'no-store');
const q = (Astro.url.searchParams.get('q') || '').trim().slice(0, 60);
const tag = (Astro.url.searchParams.get('tag') || '').trim().slice(0, 12);
const all = listApprovedResources();
const parseTags = (resource: ResourceRow): string[] => {
  try { const parsed: unknown = JSON.parse(resource.tags_json); return Array.isArray(parsed) ? parsed.filter((t): t is string => typeof t === 'string') : []; } catch { return []; }
};
const tagCounts = new Map<string, number>();
for (const resource of all) for (const t of parseTags(resource)) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts].map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count);
const resources = all.filter((resource) => {
  if (tag && !parseTags(resource).includes(tag)) return false;
  if (q) {
    const haystack = `${resource.title} ${resource.description}`.toLowerCase();
    if (!haystack.includes(q.toLowerCase())) return false;
  }
  return true;
});
const messages: Record<string, string> = {
  pending: '资源已提交，管理员审核后公开。',
  published: '资源已发布。',
  invalid: '请检查标题（2–60 字）、简介（200 字内）和标签（最多 4 个）。',
  limited: '投稿太频繁，请稍后再试。',
  blocked: '投稿未能通过发布规则。',
};
const message = messages[Astro.url.searchParams.get('submit') || ''];
---

<BaseLayout title="资源库" description="发现并分享好用的软件与工具。">
  <div class="container">
    <header class="page-head"><p class="eyebrow">RESOURCE HUB</p><h1>资源库</h1><p>好用的软件、工具和网站，欢迎投稿分享。</p></header>
    {message && <p class={message.includes('已') ? 'form-success' : 'form-error'} role="status">{message}</p>}
    <form class="blog-search" action="/resources/" method="get">
      <label for="resource-search-input">搜索资源</label>
      <input id="resource-search-input" name="q" value={q} maxlength="60" placeholder="名称或简介关键词" />
      {tag && <input type="hidden" name="tag" value={tag} />}
      <button class="small-button" type="submit">搜索</button>
    </form>
    {tags.length > 0 && <nav class="tag-index" aria-label="资源标签"><a href="/resources/" class:list={{ active: !tag }}>全部 <span>{all.length}</span></a>{tags.map((item) => <a href={`/resources/?tag=${encodeURIComponent(item.name)}`} class:list={{ active: tag === item.name }}>{item.name} <span>{item.count}</span></a>)}</nav>}

    <details class="resource-submit">
      <summary class="text-link">分享一个资源 →</summary>
      {viewer ? <form class="guestbook-form" action="/api/resources" method="post">
        <label class="field">名称<input name="title" required minlength="2" maxlength="60" /></label>
        <label class="field">官网或下载地址<input name="url" type="url" maxlength="300" placeholder="https://…（可留空）" /></label>
        <label class="field">简介<textarea name="description" rows="2" maxlength="200" placeholder="一句话说明它好在哪里"></textarea></label>
        <label class="field">标签<input name="tags" maxlength="60" placeholder="工具, 阅读（英文逗号分隔，最多 4 个）" /></label>
        <button class="primary-button" type="submit">提交分享</button>
        {viewer.role !== 'admin' && <p class="form-note">投稿将在管理员审核后显示。</p>}
      </form> : <p><a class="text-link" href="/login/">登录</a>或<a class="text-link" href="/register/">注册</a>后可以分享资源。</p>}
    </details>

    {resources.length ? <div class="resource-grid">
      {resources.map((resource) => (
        <article class="resource-card">
          <div class="resource-head">
            <strong>{resource.title}</strong>
            {resource.recommended === 1 && <span class="resource-badge">站长推荐</span>}
          </div>
          {resource.description && <p>{resource.description}</p>}
          <ul class="pill-list">{parseTags(resource).map((t) => <li><a class="pill" href={`/resources/?tag=${encodeURIComponent(t)}`}>{t}</a></li>)}</ul>
          <footer class="resource-foot">
            <span class="muted">{resource.submitter}</span>
            {resource.url && <a class="text-link" href={resource.url} target="_blank" rel="noopener noreferrer">访问官网 ↗</a>}
          </footer>
        </article>
      ))}
    </div> : <p class="empty-note">没有找到符合条件的资源。</p>}
  </div>
</BaseLayout>

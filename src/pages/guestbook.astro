---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getViewer } from '../lib/auth';
import { listApprovedGuestbook } from '../lib/db';

const viewer = getViewer(Astro.cookies);
Astro.response.headers.set('Cache-Control', 'no-store');
const entries = listApprovedGuestbook();
const messages: Record<string, string> = {
  pending: '留言已提交，审核通过后会上墙。',
  invalid: '留言需为 2–300 字。',
  limited: '留言太频繁，请稍后再试。',
  blocked: '留言未能通过发布规则。',
};
const message = messages[Astro.url.searchParams.get('post') || ''];
---

<BaseLayout title="留言墙" description="留下你的想法与建议。">
  <div class="container">
    <header class="page-head"><p class="eyebrow">GUESTBOOK</p><h1>留言墙</h1><p>不用写文章也能说点什么 —— 想法、建议、路过打卡都欢迎。</p></header>
    {message && <p class={message.includes('已提交') ? 'form-success' : 'form-error'} role="status">{message}</p>}
    <form class="guestbook-form" action="/api/guestbook" method="post">
      {!viewer && <label class="field">昵称（可不填）<input name="nickname" maxlength="16" placeholder="匿名用户" /></label>}
      <label class="field">{viewer ? `以 ${viewer.username} 的身份留言` : '留言'}<textarea name="body" rows="3" minlength="2" maxlength="300" required placeholder="写下你的想法…"></textarea></label>
      <button class="primary-button" type="submit">贴上墙</button>
      <p class="form-note">留言将在管理员审核后显示。</p>
    </form>
    {entries.length ? <ol class="guestbook-wall">
      {entries.map((entry) => (
        <li class="guestbook-note">
          <p>{entry.body}</p>
          <footer>
            <span class="guestbook-author">{entry.avatar && <img class="avatar avatar-small" src={entry.avatar} alt="" />}{entry.nickname}</span>
            <time>{new Date(entry.created_at).toLocaleDateString('zh-CN')}</time>
          </footer>
        </li>
      ))}
    </ol> : <p class="empty-note">墙上还空着，来贴第一张便签吧。</p>}
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getViewer } from '../lib/auth';

const viewer = getViewer(Astro.cookies);
if (!viewer) return Astro.redirect('/login/?error=required');
Astro.response.headers.set('Cache-Control', 'no-store');
---

<BaseLayout title="我的账号" description="账号信息与头像设置。" robots="noindex, nofollow">
  <div class="container">
    <header class="page-head"><p class="eyebrow">ACCOUNT</p><h1>我的账号</h1><p>{viewer.username} · {viewer.role === 'admin' ? '管理员' : '读者'}</p></header>
    <section class="account-card">
      <div class="account-avatar-row">
        {viewer.avatar
          ? <img class="avatar avatar-large" src={viewer.avatar} alt={`${viewer.username} 的头像`} />
          : <span class="avatar avatar-large avatar-fallback">{viewer.username.slice(0, 1).toUpperCase()}</span>}
        <div>
          <strong>{viewer.username}</strong>
          <p class="muted">头像会显示在评论区和留言墙。支持 PNG / JPG / WebP / GIF，不超过 4 MB。</p>
        </div>
      </div>
      <div class="cover-upload-row">
        <input id="avatar-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
        <button id="avatar-upload" class="small-button" type="button">上传头像</button>
        <span id="avatar-status" role="status"></span>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function setupAccountPage() {
    const button = document.querySelector<HTMLButtonElement>('#avatar-upload');
    if (!button || button.dataset.ready) return;
    button.dataset.ready = '1';
    const input = document.querySelector<HTMLInputElement>('#avatar-file');
    const status = document.querySelector<HTMLElement>('#avatar-status');
    button.addEventListener('click', async () => {
      const file = input?.files?.[0];
      if (!file || !status) { if (status) status.textContent = '请先选择图片。'; return; }
      status.textContent = '正在上传…';
      button.disabled = true;
      const data = new FormData();
      data.set('image', file);
      try {
        const response = await fetch('/api/account/avatar', { method: 'POST', body: data });
        const result = await response.json();
        if (!response.ok) { status.textContent = result.error || '上传失败。'; return; }
        status.textContent = '头像已更新。';
        window.location.reload();
      } catch {
        status.textContent = '网络错误，请重试。';
      } finally {
        button.disabled = false;
      }
    });
  }
  document.addEventListener('astro:page-load', setupAccountPage);
</script>

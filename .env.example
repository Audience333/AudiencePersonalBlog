# Public address used to generate canonical links, RSS, and sitemap URLs.
PUBLIC_SITE_ORIGIN=http://localhost:4321

# Persistent SQLite database and uploaded-image locations.
BLOG_DB_PATH=./data/blog.sqlite
BLOG_UPLOAD_DIR=./data/uploads

# Music folder read by the floating player. Drop audio files here.
BLOG_MUSIC_DIR=./music

# Standalone Node server address.
HOST=127.0.0.1
PORT=4321
NODE_ENV=production
